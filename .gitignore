# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next
/out

# local database (Phase 1, decision D1)
local.db
local.db-*
*.db
*.db-journal
*.db-wal
*.db-shm

# The e2e probe chart (Phase 6, decision D10). e2e/patients.spec.ts writes one
# of these into src/content/patients/ to prove that adding a file publishes a
# patient, and deletes it in a finally. Ignored so a killed run leaves nothing
# committable.
src/content/patients/zz-probe-*.mdx

# The e2e probe transcript (Phase 7, decision D11). Same arrangement as the
# chart probe above: e2e/transcripts.spec.ts writes one to prove that adding a
# file publishes a session, and deletes it in a finally.
src/content/transcripts/zz-probe-*.mdx

# playwright
/test-results
/playwright-report
/blob-report
/.playwright

# build output
/dist
/build
/out-tsc

# misc
/tmp
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/*
